# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
SERVICE_MODE=api

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://relavoi:relavoi_dev@localhost:5432/relavoi
DB_POOL_MIN=2
DB_POOL_MAX=10

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=relavoi:

# ─── Auth / Crypto ────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-at-least-32-character-random-string-for-production
JWT_EXPIRY=15m
ENCRYPTION_MASTER_KEY=replace-with-64-character-hex-random-string-for-aes-256-gcm-key-here

# ─── Africa's Talking (CPaaS) ─────────────────────────────────────────────────
AT_API_KEY=your-at-sandbox-api-key
AT_USERNAME=sandbox
AT_ENVIRONMENT=sandbox

# ─── Twilio (optional, secondary CPaaS) ───────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ─── Firebase (optional, push notifications) ──────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=

# ─── Webhooks ─────────────────────────────────────────────────────────────────
WEBHOOK_BASE_URL=https://api.relavoi.com
WEBHOOK_HMAC_ALGO=sha256

# ─── Number Pool ──────────────────────────────────────────────────────────────
POOL_COOLDOWN_MINUTES=5
POOL_LOW_THRESHOLD_PERCENT=20
POOL_AUTO_PROVISION_THRESHOLD_PERCENT=20

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_DEFAULT_GRACE_PERIOD_MINUTES=15
SESSION_DEFAULT_MAX_DURATION_MINUTES=120
SESSION_EXPIRY_CHECK_INTERVAL_SECONDS=30

# ─── Circuit Breaker (per architecture spec) ──────────────────────────────────
CB_FAILURE_THRESHOLD=5
CB_ERROR_RATE_THRESHOLD=0.1
CB_ERROR_RATE_WINDOW_SECONDS=120
CB_HEALTH_CHECK_INTERVAL_SECONDS=30
CB_RECOVERY_CHECK_COUNT=5
CB_HALF_OPEN_TRAFFIC_PERCENT=10

# ─── Test Mode ────────────────────────────────────────────────────────────────
LOAD_TEST_MODE=false
